// Deploys the Books phone app: npx wrangler deploy -c workers/receipt-demo/wrangler.jsonc (see workers/books/wrangler.jsonc).
{
  "name": "receipt-demo",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "services": [{ "binding": "BOOKS", "service": "books" }]
}
