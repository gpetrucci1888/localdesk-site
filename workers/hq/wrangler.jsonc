// Deploys the owner HQ: npx wrangler deploy -c workers/hq/wrangler.jsonc (see workers/books/wrangler.jsonc).
// Secrets (OWNER_PASSWORD, ADMIN_KEY, STRIPE_KEY) are set in the Cloudflare dashboard and kept. Address: hq.localdeskai.co.uk
{
  "name": "hq",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "workers_dev": false,
  "durable_objects": { "bindings": [{ "name": "VAULT", "class_name": "Vault" }] },
  "services": [{ "binding": "BOOKS", "service": "books" }],
  "triggers": { "crons": ["30 6 * * *"] }
}
